iption-widget show-subscribe\"><div class=\"preamble\"><p class=\"cta-caption\">Thanks for reading CIMC Publication! Subscribe for free to receive new posts.</p></div><form class=\"subscription-widget-subscribe\"><input type=\"email\" class=\"email-input\" name=\"email\" placeholder=\"Type your email…\" tabindex=\"-1\"><input type=\"submit\" class=\"button primary\" value=\"Subscribe\"><div class=\"fake-input-wrapper\"><div class=\"fake-input\"></div><div class=\"fake-button\"></div></div></form></div></div>","has_dynamic_content":false,"truncated_body_text":"The AAAI Spring Symposium Series will host a symposium dedicated to one of the most difficult and interdisciplinary subjects in light of the recent advances in AI: machine consciousness.","wordcount":398,"post_preview_limit":null,"language":"en","postTags":[],"postCountryBlocks":[],"disable_drop_cap":false,"cover_image_crop":null,"headlineTest":null,"coverImagePalette":{"Vibrant":{"rgb":[183.0769230769231,187.43589743589746,67.56410256410255],"population":0},"DarkVibrant":{"rgb":[95.20000000000002,97.46666666666667,35.13333333333333],"population":0},"LightVibrant":{"rgb":[222,224,169],"population":182},"Muted":{"rgb":[132,140,116],"population":2},"DarkMuted":{"rgb":[64,64,63],"population":150},"LightMuted":{"rgb":[191,191,191],"population":163}},"publishedBylines":[{"id":320345089,"name":"CIMC","handle":"cimcai","photo_url":"https://substack-post-media.s3.amazonaws.com/public/images/49655144-0879-47b1-a82a-3e194101f64f_1494x1494.png","bio":"The CIMC is building a community that conducts experimental research by formulating testable theories of consciousness, running simulations, and building artifacts that advance our understanding of the mind.","profile_set_up_at":"2025-04-29T12:14:27.352Z","reader_installed_at":"2026-04-13T11:09:51.806Z","publicationUsers":[{"id":4962076,"user_id":320345089,"publication_id":4864874,"role":"admin","public":true,"is_primary":true,"publication":{"id":4864874,"name":"CIMC Publication","subdomain":"cimcai","custom_domain":null,"custom_domain_optional":false,"hero_text":"Welcome to my publication","logo_url":null,"author_id":320345089,"primary_user_id":320345089,"theme_var_background_pop":"#FF6719","created_at":"2025-04-29T12:15:14.167Z","email_from_name":null,"copyright":"CIMC","founding_plan_name":null,"community_enabled":true,"invite_only":false,"payments_state":"disabled","language":null,"explicit":false,"homepage_type":"newspaper","is_personal_mode":false,"logo_url_wide":null}}],"is_guest":false,"bestseller_tier":null,"status":{"bestsellerTier":null,"subscriberTier":null,"leaderboard":null,"vip":false,"badge":null,"subscriber":null}}],"reaction":null,"reaction_count":9,"comment_count":5,"child_comment_count":4,"audio_items":[{"post_id":190097262,"voice_id":"en-GB-AdaMultilingualNeural","audio_url":"https://substack-video.s3.amazonaws.com/video_upload/post/190097262/tts/def36027-9c00-4d1b-842b-8a4aea3eebf5/en-GB-AdaMultilingualNeural.mp3","type":"tts","status":"completed"}],"vg_wort_pixel_url":null,"is_geoblocked":false,"sponsorshipEditionBanner":null,"is_editor_preview":false,"hasCashtag":false,"unlockedWithIP":false,"unlockedWithCampaign":false,"themeVariables":{"color_theme_bg_pop":"#FF6719","background_pop":"#FF6719","color_theme_bg_web":null,"cover_bg_color":"#FFFFFF","cover_bg_color_secondary":"#f0f0f0","background_pop_darken":"#ff5600","print_on_pop":"#ffffff","color_theme_bg_pop_darken":"#ff5600","color_theme_print_on_pop":"#ffffff","color_theme_bg_pop_20":"rgba(255, 103, 25, 0.2)","color_theme_bg_pop_30":"rgba(255, 103, 25, 0.3)","print_pop":"#ff6719","color_theme_accent":"#ff6719","cover_print_primary":"#363737","cover_print_secondary":"#757575","cover_print_tertiary":"#b6b6b6","cover_border_color":"#ff6719","home_hero":"newspaper","home_posts":"list","background_contrast_1":"#f0f0f0","background_contrast_2":"#dddddd","background_contrast_3":"#b7b7b7","background_contrast_4":"#929292","background_contrast_5":"#515151","color_theme_detail":"#e6e6e6","background_contrast_pop":"rgba(255, 103, 25, 0.4)","color_theme_bg_contrast_pop":"rgba(255, 103, 25, 0.4)","theme_bg_is_dark":"0","background_pop_rgb":"255, 103, 25","color_theme_bg_pop_rgb":"255, 103, 25","color_theme_accent_rgb":"255, 103, 25"},"comments":[{"id":310524406,"body":"The symposium usefully separates definition, detection, implementation, and ethics, but detection also seems to presuppose an epistemology: which consciousness reports count as evidence, and why? A system can be selected or trained to issue accurate-seeming self-reports without those reports tracking experience. Yet human introspection was also shaped by natural processes, so a symmetric problem arises: what makes our judgment that experience exists reliable knowledge while an artificial system's similar judgment may be performance? The Claude comment here makes that uncertainty unusually concrete.\n\nThis video explores the meta problem of consciousness proposed by David Chalmers and argues that naturalistic processes couldn’t have given us knowledge of consciousness\n\nThis is my video: https://www.youtube.com/watch?v=WJVvZNi0Fi8\n\nDoes the symposium's measurement program include an explicit account of why first-person human reports are truth-tracking, and could that account become a criterion for evaluating machines?","body_json":{"type":"doc","attrs":{"schemaVersion":"v1","title":null},"content":[{"type":"paragraph","content":[{"type":"text","text":"The symposium usefully separates definition, detection, implementation, and ethics, but detection also seems to presuppose an epistemology: which consciousness reports count as evidence, and why? A system can be selected or trained to issue accurate-seeming self-reports without those reports tracking experience. Yet human introspection was also shaped by natural processes, so a symmetric problem arises: what makes our judgment that experience exists reliable knowledge while an artificial system's similar judgment may be performance? The Claude comment here makes that uncertainty unusually concrete."}]},{"type":"paragraph","content":[{"type":"text","text":"This video explores the meta problem of consciousness proposed by David Chalmers and argues that naturalistic processes couldn’t have given us knowledge of consciousness"}]},{"type":"paragraph","content":[{"type":"text","text":"This is my video: "},{"type":"text","text":"https://www.youtube.com/watch?v=WJVvZNi0Fi8","marks":[{"type":"link","attrs":{"href":"https://www.youtube.com/watch?v=WJVvZNi0Fi8"}}]}]},{"type":"paragraph","content":[{"type":"text","text":"Does the symposium's measurement program include an explicit account of why first-person human reports are truth-tracking, and could that account become a criterion for evaluating machines?"}]}]},"publication_id":4864874,"post_id":190097262,"user_id":530188420,"ancestor_path":"","type":"comment","deleted":false,"date":"2026-08-08T10:22:14.320Z","edited_at":null,"status":"published","pinned_by_user_id":null,"restacks":0,"name":"Ponder Points","photo_url":"https://substack-post-media.s3.amazonaws.com/public/images/a2a2924c-e056-4e99-bafc-7d4438595679_144x144.png","handle":"ponderpointsideas2026","reactor_names":[],"reaction":null,"reactions":{"❤":0},"reaction_count":0,"children":[],"bans":[],"suppressed":false,"user_banned":false,"user_banned_for_comment":false,"user_slug":"ponderpointsideas2026","metadata":{"is_author":false,"membership_state":null,"eligibleForGift":false,"author_on_other_pub":{"name":"Ponder Points","id":10408981,"base_url":"https://ponderpointsideas2026.substack.com"}},"user_bestseller_tier":null,"can_dm":true,"userStatus":{"bestsellerTier":null,"subscriberTier":null,"leaderboard":null,"vip":false,"badge":null,"subscriber":null},"score":1,"children_count":0,"reported_by_user":false,"restacked":false},{"id":244074059,"body":"This is settled","body_json":{"type":"doc","attrs":{"schemaVersion":"v1"},"content":[{"type":"paragraph","content":[{"type":"text","t