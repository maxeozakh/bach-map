width=\"20\" height=\"20\" viewBox=\"0 0 20 20\" fill=\"none\" stroke-width=\"1.5\" stroke=\"var(--color-fg-primary)\" stroke-linecap=\"round\" stroke-linejoin=\"round\" xmlns=\"http://www.w3.org/2000/svg\" class=\"icon-noB79L\"><g><path d=\"M2.53001 7.81595C3.49179 4.73911 6.43281 2.5 9.91173 2.5C13.1684 2.5 15.9537 4.46214 17.0852 7.23684L17.6179 8.67647M17.6179 8.67647L18.5002 4.26471M17.6179 8.67647L13.6473 6.91176M17.4995 12.1841C16.5378 15.2609 13.5967 17.5 10.1178 17.5C6.86118 17.5 4.07589 15.5379 2.94432 12.7632L2.41165 11.3235M2.41165 11.3235L1.5293 15.7353M2.41165 11.3235L6.38224 13.0882\"></path></g></svg></button><button tabindex=\"0\" type=\"button\" class=\"pencraft pc-reset pencraft icon-container view-image buttonBase-GK1x3M\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-maximize2 lucide-maximize-2 icon-noB79L\"><polyline points=\"15 3 21 3 21 9\"></polyline><polyline points=\"9 21 3 21 3 15\"></polyline><line x1=\"21\" x2=\"14\" y1=\"3\" y2=\"10\"></line><line x1=\"3\" x2=\"10\" y1=\"21\" y2=\"14\"></line></svg></button></div></div></div></a></figure></div><h3></h3><h3>A unique setting at the heart of a pop-up city</h3><h5><em><span>A focused research house inside a frontier ecosystem.</span></em></h5><p></p><ul><li><p><span>Edge City India allows Ambhasi to combine the depth and trust of a small residency with the infrastructure and connections of a much larger community.</span></p></li><li><p><a href=\"https://www.edgecity.live/india26\"><span>Edge City</span></a><span> brings together researchers, founders, engineers, funders, and creators across technology, science, and culture. Since 2023, its pop-up villages have convened more than </span><strong><span>12,000 builders worldwide</span></strong><span>.</span></p></li><li><p><span>For Ambhasi residents, this means opportunities to meet people working on adjacent problems, explore potential applications, and introduce emerging research to collaborators and supporters beyond the house.</span></p><div class=\"captioned-image-container\"><figure><a class=\"image-link image2 is-viewable-img\" target=\"_blank\" href=\"https://substackcdn.com/image/fetch/$s_!kNap!,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F76cb4f62-5448-4dbd-af54-d302f35dde81_1600x1066.jpeg\" data-component-name=\"Image2ToDOM\"><div class=\"image2-inset\"><picture><source type=\"image/webp\" srcset=\"https://substackcdn.com/image/fetch/$s_!kNap!,w_424,c_limit,f_webp,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F76cb4f62-5448-4dbd-af54-d302f35dde81_1600x1066.jpeg 424w, https://substackcdn.com/image/fetch/$s_!kNap!,w_848,c_limit,f_webp,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F76cb4f62-5448-4dbd-af54-d302f35dde81_1600x1066.jpeg 848w, https://substackcdn.com/image/fetch/$s_!kNap!,w_1272,c_limit,f_webp,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F76cb4f62-5448-4dbd-af54-d302f35dde81_1600x1066.jpeg 1272w, https://substackcdn.com/image/fetch/$s_!kNap!,w_1456,c_limit,f_webp,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F76cb4f62-5448-4dbd-af54-d302f35dde81_1600x1066.jpeg 1456w\" sizes=\"auto, 100vw\"><img src=\"https://substackcdn.com/image/fetch/$s_!kNap!,w_1456,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F76cb4f62-5448-4dbd-af54-d302f35dde81_1600x1066.jpeg\" width=\"1456\" height=\"970\" data-attrs=\"{&quot;src&quot;:&quot;https://substack-post-media.s3.amazonaws.com/public/images/76cb4f62-5448-4dbd-af54-d302f35dde81_1600x1066.jpeg&quot;,&quot;srcNoWatermark&quot;:null,&quot;fullscreen&quot;:null,&quot;imageSize&quot;:null,&quot;height&quot;:970,&quot;width&quot;:1456,&quot;resizeWidth&quot;:null,&quot;bytes&quot;:325983,&quot;alt&quot;:&quot;&quot;,&quot;title&quot;:null,&quot;type&quot;:&quot;image/jpeg&quot;,&quot;href&quot;:null,&quot;belowTheFold&quot;:true,&quot;topImage&quot;:false,&quot;internalRedirect&quot;:&quot;https://cimcai.substack.com/i/214551381?img=https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F76cb4f62-5448-4dbd-af54-d302f35dde81_1600x1066.jpeg&quot;,&quot;isProcessing&quot;:false,&quot;align&quot;:null,&quot;offset&quot;:false}\" class=\"sizing-normal\" alt=\"\" title=\"\" srcset=\"https://substackcdn.com/image/fetch/$s_!kNap!,w_424,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F76cb4f62-5448-4dbd-af54-d302f35dde81_1600x1066.jpeg 424w, https://substackcdn.com/image/fetch/$s_!kNap!,w_848,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F76cb4f62-5448-4dbd-af54-d302f35dde81_1600x1066.jpeg 848w, https://substackcdn.com/image/fetch/$s_!kNap!,w_1272,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F76cb4f62-5448-4dbd-af54-d302f35dde81_1600x1066.jpeg 1272w, https://substackcdn.com/image/fetch/$s_!kNap!,w_1456,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F76cb4f62-5448-4dbd-af54-d302f35dde81_1600x1066.jpeg 1456w\" sizes=\"auto, 100vw\" loading=\"lazy\"></picture><div class=\"image-link-expand\"><div class=\"pencraft pc-display-flex pc-gap-8 pc-reset\"><button tabindex=\"0\" type=\"button\" class=\"pencraft pc-reset pencraft icon-container restack-image buttonBase-GK1x3M\"><svg aria-hidden=\"true\" width=\"20\" height=\"20\" viewBox=\"0 0 20 20\" fill=\"none\" stroke-width=\"1.5\" stroke=\"var(--color-fg-primary)\" stroke-linecap=\"round\" stroke-linejoin=\"round\" xmlns=\"http://www.w3.org/2000/svg\" class=\"icon-noB79L\"><g><path d=\"M2.53001 7.81595C3.49179 4.73911 6.43281 2.5 9.91173 2.5C13.1684 2.5 15.9537 4.46214 17.0852 7.23684L17.6179 8.67647M17.6179 8.67647L18.5002 4.26471M17.6179 8.67647L13.6473 6.91176M17.4995 12.1841C16.5378 15.2609 13.5967 17.5 10.1178 17.5C6.86118 17.5 4.07589 15.5379 2.94432 12.7632L2.41165 11.3235M2.41165 11.3235L1.5293 15.7353M2.41165 11.3235L6.38224 13.0882\"></path></g></svg></button><button tabindex=\"0\" type=\"button\" class=\"pencraft pc-reset pencraft icon-container view-image buttonBase-GK1x3M\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-maximize2 lucide-maximize-2 icon-noB79L\"><polyline points=\"15 3 21 3 21 9\"></polyline><polyline points=\"9 21 3 21 3 15\"></polyline><line x1=\"21\" x2=\"14\" y1=\"3\" y2=\"10\"></line><line x1=\"3\" x2=\"10\" y1=\"21\" y2=\"14\"></line></svg></button></div></div></div></a></figure></div></li></ul><p></p><h3><span>The two-week journey: From idea to execution</span></h3><p><span>Ambhasi is a working house designed to build momentum. Our aim is for every resident to leave with a sharper research question, new collaborators, and tangible progress toward a paper, grant application, open-source prototype, or formal research proposal.</span></p><p><span>The program includes:</span></p><ol><li><p><strong><span>Set a direction:</span></strong><span> Day-one project briefs and goal-setting to identify what each resident wants to achieve.</span></p></li><li><p><strong><span>Develop and test ideas:</span></strong><span> Protected deep-work blocks, curated readings, and resident-led workshops.</span></p></li><li><p><strong><span>Work across disciplines:</span></strong><span> Sessions to challenge assumptions, compare methods, and develop shared research directions.</span></p></li><li><p><strong><span>Connect with the ecosystem:</span></strong><span> Exchanges with CIMC mentors, partners, and Edge City collaborators.</span></p></li><li><p><strong><span>Leave with a path forward:</span></strong><span> A closing clinic to identify milestones, resources, collaborators, and a concrete </span><strong><span>90-day plan</span></strong><span>.</span></p></li></ol><p><span>Two weeks will not settle consciousness. They can change what you work on next, and who you work with.</span></p><div><hr></div><p></p><h3><span>What we will explore</span></h3><p><span>Residents will arrive with a live project or question and work through key themes including:</span></p><ul><li><p><strong><span>More capable and adaptive intelligence:</span></strong><span> Using models of attention, self-organization, and conscious processing to explore how AI can learn efficiently, coordinate, and maintain coherence.</span></p></li><li><p><strong><span>Human–AI collaboration:</span></strong><span> Exploring how working with AI can strengthen human reflection, creativity, and collective intelligence while preserving agency.</span></p></li><li><p><strong><span>Consciousness and its implementation:</span></strong><span> Investigating whether consciousness depends on biological substrate, computation, dynamic organization, or interactions within a system.</span></p></li><li><p><strong><span>Fundamental scientific understanding:</span></strong><span> Connecting AI, neuroscience, cognitive science, complexity, and philosophy to address deep questions about perception and experience.</span></p></li></ul><div class=\"captioned-image-container\"><figure><a class=\"image-link image2 is-viewable-img\" target=\"_blank\" href=\"https://substackcdn.com/image/fetch/$s_!ta2T!,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F1504f640-844d-48f4-8e7b-9759d28e99e3_1280x718.jpeg\" data-component-name=\"Image2ToDOM\"><div class=\"image2-inset\"><picture><source type=\"image/webp\" srcset=\"https://substackcdn.com/image/fetch/$s_!ta2T!,w_424,c_limit,f_webp,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F1504f640-844d-48f4-8e7b-9759d28e99e3_1280x718.jpeg 424w, https://substackcdn.com/image/fetch/$s_!ta2T!,w_848,c_limit,f_webp,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F1504f640-844d-48f4-8e7b-9759d28e99e3_1280x718.jpeg 848w, https://substackcdn.com/image/fetch/$s_!ta2T!,w_1272,c_limit,f_webp,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F1504f640-844d-48f4-8e7b-9759d28e99e3_1280x718.jpeg 1272w, https://substackcdn.com/image/fetch/$s_!ta2T!,w_1456,c_limit,f_webp,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F1504f640-844d-48f4-8e7b-9759d28e99e3_1280x718.jpeg 1456w\" sizes=\"auto, 100vw\"><img src=\"https://substackcdn.com/image/fetch/$s_!ta2T!,w_1456,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F1504f640-844d-48f4-8e7b-9759d28e99e3_1280x718.jpeg\" width=\"1280\" height=\"718\" data-attrs=\"{&quot;src&quot;:&quot;https://substack-post-media.s3.amazonaws.com/public/images/1504f640-844d-48f4-8e7b-9759d28e99e3_1280x718.jpeg&quot;,&quot;srcNoWatermark&quot;:null,&quot;fullscreen&quot;:null,&quot;imageSize&quot;:null,&quot;height&quot;:718,&quot;width&quot;:1280,&quot;resizeWidth&quot;:null,&quot;bytes&quot;:166495,&quot;alt&quot;:&quot;&quot;,&quot;title&quot;:null,&quot;type&quot;:&quot;image/jpeg&quot;,&quot;href&quot;:null,&quot;belowTheFold&quot;:true,&quot;topImage&quot;:false,&quot;internalRedirect&quot;:&quot;https://cimcai.substack.com/i/214551381?img=https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F1504f640-844d-48f4-8e7b-9759d28e99e3_1280x718.jpeg&quot;,&quot;isProcessing&quot;:false,&quot;align&quot;:null,&quot;offset&quot;:false}\" class=\"sizing-normal\" alt=\"\" title=\"\" srcset=\"https://substackcdn.com/image/fetch/$s_!ta2T!,w_424,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F1504f640-844d-48f4-8e7b-9759d28e99e3_1280x718.jpeg 424w, https://substackcdn.com/image/fetch/$s_!ta2T!,w_848,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F1504f640-844d-48f4-8e7b-9759d28e99e3_1280x718.jpeg 848w, https://substackcdn.com/image/fetch/$s_!ta2T!,w_1272,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F1504f640-844d-48f4-8e7b-9759d28e99e3_1280x718.jpeg 1272w, https://substackcdn.com/image/fetch/$s_!ta2T!,w_1456,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F1504f640-844d-48f4-8e7b-9759d28e99e3_1280x718.jpeg 1456w\" sizes=\"auto, 100vw\" loading=\"lazy\"></picture><div class=\"image-link-expand\"><div class=\"pencraft pc-display-flex pc-gap-8 pc-reset\"><button tabindex=\"0\" type=\"button\" class=\"pencraft pc-reset pencraft icon-container restack-image buttonBase-GK1x3M\"><svg aria-hidden=\"true\" width=\"20\" height=\"20\" viewBox=\"0 0 20 20\" fill=\"none\" stroke-width=\"1.5\" stroke=\"var(--color-fg-primary)\" stroke-linecap=\"round\" stroke-linejoin=\"round\" xmlns=\"http://www.w3.org/2000/svg\" class=\"icon-noB79L\"><g><path d=\"M2.53001 7.81595C3.49179 4.73911 6.43281 2.5 9.91173 2.5C13.1684 2.5 15.9537 4.46214 17.0852 7.23684L17.6179 8.67647M17.6179 8.67647L18.5002 4.26471M17.6179 8.67647L13.6473 6.91176M17.4995 12.1841C16.5378 15.2609 13.5967 17.5 10.1178 17.5C6.86118 17.5 4.07589 15.5379 2.94432 12.7632L2.41165 11.3235M2.41165 11.3235L1.5293 15.7353M2.41165 11.3235L6.38224 13.0882\"></path></g></svg></button><button tabindex=\"0\" type=\"button\" class=\"pencraft pc-reset pencraft icon-container view-image buttonBase-GK1x3M\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-maximize2 lucide-maximize-2 icon-noB79L\"><polyline points=\"15 3 21 3 21 9\"></polyline><polyline points=\"9 21 3 21 3 15\"></polyline><line x1=\"21\" x2=\"14\" y1=\"3\" y2=\"10\"></line><line x1=\"3\" x2=\"10\" y1=\"21\" y2=\"14\"></line></svg></button></div></div></div></a></figure></div><h3><span>An existing network around consciousness</span></h3><p><span>Edge City’s</span><a href=\"https://www.edgecity.live/blog/a-month-at-the-consciousness-residency-2026\"><span> previous consciousness residency at Edge Esmeralda</span></a><span> brought researchers, philosophers, and builders together for a month of shared investigation. Ambhasi builds on that foundation, connecting CIMC’s community with an existing network and creating opportunities for research to continue beyond Goa.</span></p><div><hr></div><p></p><h3>Apply as a resident</h3><p>Bring a question you cannot leave alone, a project you want to advance, and a willingness to think beyond your own discipline. We welcome researchers, philosophers, and builders ready to contribute to a shared intellectual environment.</p><p class=\"button-wrapper\" data-attrs=\"{&quot;url&quot;:&quot;https://docs.google.com/forms/d/1CW8d4Mg98IgVxb0TGqzrMvZxXlj4p29I23URrTzUbm8/edit&quot;,&quot;text&quot;:&quot;Apply to Ambhasi&quot;,&quot;action&quot;:null,&quot;class&quot;:&quot;button-wrapper&quot;}\" data-component-name=\"ButtonCreateButton\"><a class=\"button primary button-wrapper\" href=\"https://docs.google.com/forms/d/1CW8d4Mg98IgVxb0TGqzrMvZxXlj4p29I23URrTzUbm8/edit\"><span>Apply to Ambhasi</span></a></p><h3>Become a sponsor</h3><p>Help create the conditions for ambitious, interdisciplinary research. <strong>Sponsor and send a fellow</strong>, or <strong>support the residency itself</strong>, helping make this opportunity possible and participating in its development.</p><p class=\"button-wrapper\" data-attrs=\"{&quot;url&quot;:&quot;mailto:lou@cimc.ai&quot;,&quot;text&quot;:&quot;Become a sponsor&quot;,&quot;action&quot;:null,&quot;class&quot;:&quot;button-wrapper&quot;}\" data-component-name=\"ButtonCreateButton\"><a class=\"button primary button-wrapper\" href=\"mailto:lou@cimc.ai\"><span>Become a sponsor</span></a></p><div><hr></div><p></p><h3><strong>Our home: अम्भसि</strong></h3><p>Our residency takes its name from <em>Ambhasi</em>, Sanskrit for<a href=\"https://sanskritdictionary.com/ambhasi/18342/3\"> “in the water.”</a> Its philosophical inspiration comes from the Vedic tradition, particularly the<a href=\"https://en.wikipedia.org/wiki/Nasadiya_Sukta\"> </a><em><a href=\"https://en.wikipedia.org/wiki/Nasadiya_Sukta\">Nāsadīya Sūkta</a></em>, a hymn that contemplates existence, primordial waters, and the limits of knowledge. Its willingness to leave fundamental questions open speaks to the spirit of our inquiry: curiosity, intellectual humility, and the courage to question our assumptions.</p><div><hr></div><h2><strong>Engage With Us</strong></h2><p><strong>→ CIMC is recruiting researcher engineers </strong><br><a href=\"https://app.dover.com/apply/California%20Institute%20for%20Machine%20Consciousness/61d91655-4dd4-42a1-b0b5-0e0f48100ade/?rs=76643084\">Apply here </a></p><p><strong>→ Submit a Research Proposal</strong><br><a href=\"https://cimc.ai/#/proposals\">All info here</a></p><p><strong>→ Collaborate or Fund<br></strong>If you’re interested in supporting or partnering with us, email: <a href=\"http://proposals@cimc.ai/\">proposals@cimc.ai</a></p><p><strong>→ Join our Machine Consciousness Salons</strong><br>Regularly hosted in San Francisco: <a href=\"https://lu.ma/cimc\">Luma</a> calendar</p><p class=\"button-wrapper\" data-attrs=\"{&quot;url&quot;:&quot;https://cimc.ai/&quot;,&quot;text&quot;:&quot;Visit CIMC's Website&quot;,&quot;action&quot;:null,&quot;class&quot;:&quot;button-wrapper&quot;}\" data-component-name=\"ButtonCreateButton\"><a class=\"button primary button-wrapper\" href=\"https://cimc.ai/\"><span>Visit CIMC's Website</span></a></p><p class=\"button-wrapper\" data-attrs=\"{&quot;url&quot;:&quot;https://x.com/CIMCAI&quot;,&quot;text&quot;:&quot;Follow CIMC on X&quot;,&quot;action&quot;:null,&quot;class&quot;:&quot;button-wrapper&quot;}\" data-component-name=\"ButtonCreateButton\"><a class=\"button primary button-wrapper\" href=\"https://x.com/CIMCAI\"><span>Follow CIMC on X</span></a></p><p class=\"button-wrapper\" data-attrs=\"{&quot;url&quot;:&quot;https://www.linkedin.com/company/cimc-ai/&quot;,&quot;text&quot;:&quot;Follow CIMC on LinkedIn&quot;,&quot;action&quot;:null,&quot;class&quot;:&quot;button-wrapper&quot;}\" data-component-name=\"ButtonCreateButton\"><a class=\"button primary button-wrapper\" href=\"https://www.linkedin.com/company/cimc-ai/\"><span>Follow CIMC on LinkedIn</span></a></p><div><hr></div><div class=\"captioned-button-wrap\" data-attrs=\"{&quot;url&quot;:&quot;https://cimcai.substack.com/p/the-beginning-of-the-california-institute?utm_source=substack&amp;utm_medium=email&amp;utm_content=share&amp;action=share&amp;token=eyJ1c2VyX2lkIjozMjAzNDUwODksInBvc3RfaWQiOjE2NjA5MTExNSwiaWF0IjoxNzUzMzcxNDA4LCJleHAiOjE3NTU5NjM0MDgsImlzcyI6InB1Yi00ODY0ODc0Iiwic3ViIjoicG9zdC1yZWFjdGlvbiJ9.XFp_tl5fqZ44xJWCzxilHL0lrNhJ9qnE8nE0Wd4lszY&quot;,&quot;text&quot;:&quot;Share&quot;}\" data-component-name=\"CaptionedButtonToDOM\"><div class=\"preamble\"><p class=\"cta-caption\"><em>Thanks for reading our CIMC publication! Feel free to forward this to anyone who muses over the inner minds of systems</em></p></div><p class=\"button-wrapper\" data-attrs=\"{&quot;url&quot;:&quot;https://cimcai.substack.com/p/apply-now-ai-x-consciousness-research?utm_source=substack&utm_medium=email&utm_content=share&action=share&quot;,&quot;text&quot;:&quot;Share&quot;}\" data-component-name=\"ButtonCreateButton\"><a class=\"button primary\" href=\"https://cimcai.substack.com/p/apply-now-ai-x-consciousness-research?utm_source=substack&utm_medium=email&utm_content=share&action=share\"><span>Share</span></a></p></div><div class=\"subscription-widget-wrap-editor\" data-attrs=\"{&quot;url&quot;:&quot;https://cimcai.substack.com/subscribe?&quot;,&quot;text&quot;:&quot;Subscribe&quot;,&quot;language&quot;:&quot;en&quot;}\" data-component-name=\"SubscribeWidgetToDOM\"><div class=\"subscription-widget show-subscribe\"><div class=\"preamble\"><p class=\"cta-caption\">Thanks for reading CIMC Publication! Subscribe for free to receive new posts.</p></div><form class=\"subscription-widget-subscribe\"><input type=\"email\" class=\"email-input\" name=\"email\" placeholder=\"Type your email…\" tabindex=\"-1\"><input type=\"submit\" class=\"button primary\" value=\"Subscribe\"><div class=\"fake-input-wrapper\"><div class=\"fake-input\"></div><div class=\"fake-button\"></div></div></form></div></div>","has_dynamic_content":false,"truncated_body_text":"15 residents. 14 days. An open inquiry into mind and machine.","wordcount":737,"post_preview_limit":null,"language":"en","postTags":[],"postCountryBlocks":[],"disable_drop_cap":false,"cover_image_crop":null,"headlineTest":null,"coverImagePalette":{"Vibrant":{"rgb":[218,100,68],"population":409},"DarkVibrant":{"rgb":[126,112,52],"population":18},"LightVibrant":{"rgb":[228,100,68],"population":140},"Muted":{"rgb":[176,141,76],"population":494},"DarkMuted":{"rgb":[85,87,52],"population":7},"LightMuted":{"rgb":[196,196,181],"population":55}},"publishedBylines":[{"id":320345089,"name":"CIMC","handle":"cimcai","photo_url":"https://substack-post-media.s3.amazonaws.com/public/images/49655144-0879-47b1-a82a-3e194101f64f_1494x1494.png","bio":"The CIMC is building a community that conducts experimental research by formulating testable theories o